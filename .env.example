# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# JWT Configuration
# ВАЖНО: Сгенерируйте надежный ключ для production!
# Пример генерации: openssl rand -base64 32
JWT_SIGNING_KEY=your-super-secret-jwt-key-here-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=24h
JWT_ISSUER=gophkeeper

# Database Configuration
DATABASE_DSN=host=localhost port=5432 user=postgres password=postgres dbname=gophkeeper sslmode=disable
